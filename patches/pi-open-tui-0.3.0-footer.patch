+/** Color embedded percentages by stress (accent → warning → error), labels muted. */
+function colorizeStatText(theme: Theme, text: string): string {
+	const parts: string[] = [];
+	let last = 0;
+	for (const match of text.matchAll(/(\d+(?:\.\d+)?)\s*%/g)) {
+		const start = match.index ?? 0;
+		parts.push(theme.fg("muted", text.slice(last, start)));
+		parts.push(theme.fg(stressColor(Number.parseFloat(match[1])), match[0]));
+		last = start + match[0].length;
+	}
+	if (parts.length === 0) return theme.fg("muted", text);
+	parts.push(theme.fg("muted", text.slice(last)));
+	return parts.join("");
+}
